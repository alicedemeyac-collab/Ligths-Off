            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onLightClick" text="*" GridPane.columnIndex="1" GridPane.rowIndex="3"><font><Font size="36.0" /></font></Button>
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onLightClick" text="*" GridPane.columnIndex="2" GridPane.rowIndex="3"><font><Font size="36.0" /></font></Button>
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onLightClick" text="*" GridPane.columnIndex="3" GridPane.rowIndex="3"><font><Font size="36.0" /></font></Button>
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onLightClick" text="*" GridPane.columnIndex="4" GridPane.rowIndex="3"><font><Font size="36.0" /></font></Button>
