    <Label text="Lights-Off" textAlignment="CENTER">
        <font>
            <Font size="30.0" />
        </font>
    </Label>

    <Label text="Éteignez toutes les lumières !" textAlignment="CENTER">
        <font>
            <Font size="16.0" />
        </font>
    </Label>

